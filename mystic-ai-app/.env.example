# API
API_BASE_URL=http://localhost:8000/api/v1
WS_BASE_URL=ws://localhost:8000/ws

# Firebase
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=mystic-ai.firebaseapp.com
FIREBASE_PROJECT_ID=mystic-ai
FIREBASE_STORAGE_BUCKET=mystic-ai.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id

# Google Sign-In
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com

# Apple Sign-In (iOS only)
APPLE_SERVICE_ID=com.mystic.ai

# RevenueCat
REVENUECAT_API_KEY_IOS=appl_your_ios_key
REVENUECAT_API_KEY_ANDROID=goog_your_android_key

# Sentry
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Segment Analytics
SEGMENT_WRITE_KEY=your-segment-write-key

# App Config
APP_VERSION=1.0.0
APP_BUILD_NUMBER=1
DEFAULT_LANGUAGE=en

# Feature Flags
ENABLE_CHAT=true
ENABLE_GAMIFICATION=true
ENABLE_VOICE_INPUT=true
