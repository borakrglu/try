# Mystic.ai Backend - Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================
# Application Settings
# ============================================
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://mystic:password@localhost:5432/mystic_ai

# ============================================
# Security & Authentication
# ============================================
# Generate a secure secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# CORS Settings
# ============================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://yourdomain.com

# ============================================
# AI Provider Configuration
# ============================================
# Choose your AI provider: gemini (FREE!), openai (paid), anthropic (paid)
AI_PROVIDER=gemini

# Google Gemini API (RECOMMENDED - FREE!)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API (Optional - Paid)
# Only needed if AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================
# AWS S3 Storage (Optional)
# ============================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=mystic-ai-uploads

# ============================================
# RevenueCat (Payment Integration)
# ============================================
REVENUECAT_API_KEY=your_revenuecat_api_key
REVENUECAT_WEBHOOK_SECRET=your_webhook_secret

# ============================================
# Firebase Cloud Messaging (Push Notifications)
# ============================================
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-credentials.json

# ============================================
# Pinecone (Vector Database for Chat Memory)
# ============================================
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=mystic-chat-memory

# ============================================
# Sentry (Error Tracking - Optional)
# ============================================
SENTRY_DSN=your_sentry_dsn_url

# ============================================
# Redis (Caching - Optional)
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_PER_MINUTE=60
