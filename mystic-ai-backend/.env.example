# Application
APP_NAME=Mystic.ai
APP_ENV=development
DEBUG=True
API_VERSION=v1

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/mystic_ai
DB_ECHO=False

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ORG_ID=org-your-org-id-here

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Pinecone
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-west1-gcp
PINECONE_INDEX_NAME=mystic-ai-memory

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=mystic-ai-uploads

# Firebase (for push notifications)
FIREBASE_PROJECT_ID=mystic-ai
FIREBASE_PRIVATE_KEY_ID=your-key-id
FIREBASE_PRIVATE_KEY=your-private-key

# RevenueCat (for subscriptions)
REVENUECAT_SECRET_KEY=your-revenuecat-secret

# Sentry
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://mystic.ai

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Email (for password reset, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@mystic.ai
SMTP_PASSWORD=your-email-password
SMTP_FROM=Mystic.ai <noreply@mystic.ai>

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
